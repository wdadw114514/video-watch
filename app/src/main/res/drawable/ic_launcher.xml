<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF1E2A44"
                android:endColor="#FF0B0D14" />
        </shape>
    </item>
    <item
        android:left="14dp"
        android:top="14dp"
        android:right="14dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#FF2EE6C8" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF05070C" />
        </shape>
    </item>
</layer-list>
